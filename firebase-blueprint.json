{
  "entities": {
    "Student": {
      "title": "Student",
      "description": "Student profile, avatar, Google photo, hearts, dhikr progress, and score data",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 120 },
        "email": { "type": "string", "maxLength": 200 },
        "photoURL": { "type": ["string", "null"], "maxLength": 1000 },
        "avatar": { "type": ["object", "null"] },
        "pet": { "type": ["string", "null"], "maxLength": 50 },
        "bubble": { "type": ["string", "null"], "maxLength": 100 },
        "score": { "type": "number" },
        "xp": { "type": "number" },
        "hearts": { "type": "number" },
        "dhikrCounts": { "type": "object" },
        "lastDhikrAt": { "type": ["object", "string", "null"] },
        "migrated": { "type": "boolean" },
        "migratedToUid": { "type": ["string", "null"], "maxLength": 128 },
        "migratedFromUid": { "type": ["string", "null"], "maxLength": 128 },
        "createdAt": { "type": ["object", "string", "null"] },
        "lastLogin": { "type": ["object", "string", "null"] }
      },
      "required": ["uid", "name", "email", "score", "hearts"]
    },
    "TomatoHit": {
      "title": "TomatoHit",
      "description": "Real-time tomato throw record between students",
      "type": "object",
      "properties": {
        "fromUid": { "type": "string", "maxLength": 128 },
        "fromName": { "type": "string", "maxLength": 120 },
        "toUid": { "type": "string", "maxLength": 128 },
        "toName": { "type": "string", "maxLength": 120 },
        "createdAt": { "type": ["object", "string"] },
        "expiresAt": { "type": ["object", "string"] }
      },
      "required": ["fromUid", "fromName", "toUid", "toName", "createdAt", "expiresAt"]
    },
    "Message": {
      "title": "Message",
      "description": "Real-time discussion message between students",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "sender": { "type": "string", "maxLength": 120 },
        "senderId": { "type": "string", "maxLength": 128 },
        "photoURL": { "type": ["string", "null"], "maxLength": 1000 },
        "avatar": { "type": ["object", "null"] },
        "pet": { "type": ["string", "null"], "maxLength": 50 },
        "module": { "type": "string", "maxLength": 100 },
        "isCreator": { "type": "boolean" },
        "body": { "type": "string", "maxLength": 1000 },
        "kind": { "type": "string", "enum": ["chat", "feedback", "tip", "question"] },
        "createdAt": { "type": ["object", "string", "null"] },
        "created_at": { "type": ["string", "null"], "maxLength": 64 },
        "likes": { "type": "number" },
        "tomatoes": { "type": "number" },
        "claps": { "type": "number" },
        "ideas": { "type": "number" },
        "reactionsUsers": { "type": "object" }
      },
      "required": ["sender", "senderId", "body", "kind"]
    }
  },
  "firestore": {
    "/students/{uid}": {
      "schema": "Student",
      "description": "Student profiles collection"
    },
    "/tomato_hits/{hitId}": {
      "schema": "TomatoHit",
      "description": "Real-time tomato throw events collection"
    },
    "/messages/{messageId}": {
      "schema": "Message",
      "description": "Discussion messages collection"
    }
  }
}
